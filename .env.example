NODE_ENV=development
PORT=3001
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
DB_FILE=data/lorekeeper.sqlite
APP_ORIGIN=http://127.0.0.1:5173

# Create a Twitch app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback

# Optional: add an OpenAI key to enable server-side memory summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
